{
  "name": "@smb/scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "security-agent": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "start": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@smb/checks": "workspace:*",
    "@smb/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
