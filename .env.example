# ---------------------------------------------------------------------------
# SMB Security Posture & Compliance Readiness Platform - example environment
# Copy to .env for local development:  cp .env.example .env
# NEVER commit a real .env. All secrets are read server-side only.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Matches the docker-compose service below.
DATABASE_URL="postgresql://smb:smb@localhost:5432/smb?schema=public"

# Session / auth signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-generate-a-real-32-byte-secret"

# Base URL of the web app (used for auth callbacks / links).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Anthropic API - powers the explanation & reporting layer ONLY.
# The product is fully functional without this; AI features degrade gracefully.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Model id used for report narration / summaries.
ANTHROPIC_MODEL="claude-sonnet-5"
# Hard ceiling on AI tokens per request (cost / abuse guard).
ANTHROPIC_MAX_TOKENS="1500"

# ---------------------------------------------------------------------------
# Scan ingestion
# ---------------------------------------------------------------------------
# Max accepted scan payload size in bytes (defense against ingestion abuse).
SCAN_MAX_BYTES="1048576"

# ---------------------------------------------------------------------------
# Local development conveniences (NEVER enable in production)
# ---------------------------------------------------------------------------
# Seeds the "Acme Dental" demo organization + fictional findings.
ENABLE_DEMO_SEED="true"
# Demo login (local only). Created by `pnpm db:seed`.
DEMO_EMAIL="owner@acmedental.example"
DEMO_PASSWORD="demo-password-local-only"

NODE_ENV="development"
